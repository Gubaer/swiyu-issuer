{
  "realm": "swiyu-issuer",
  "displayName": "swiyu-issuer (dev/explore)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "attributes": {
    "defaultSignatureAlgorithm": "EdDSA"
  },
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "eddsa-generated",
        "providerId": "eddsa-generated",
        "subComponents": {},
        "config": {
          "priority": ["200"],
          "enabled": ["true"],
          "active": ["true"],
          "eddsaEllipticCurveKey": ["Ed25519"]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "mgmtapi-audience",
      "description": "Adds swiyu-issuer-mgmtapi to the access-token audience so the resource server accepts the token.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "mgmtapi-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "swiyu-issuer-mgmtapi",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "act-as-user",
      "description": "Adds the user's federated `user_identity` (iss, sub) for act-as-user. OPTIONAL: only on the exchanged token (requested at exchange), never on the base token — a first-party token with `user_identity` but no `act` is rejected by mgmtapi.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "user_identity.iss",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "user_identity.iss",
            "claim.value": "http://localhost:8083/realms/swiyu-issuer",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "user_identity.sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "user_identity.sub",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "swiyu-issuer-mgmtapi",
      "name": "swiyu-issuer Management API (resource server)",
      "description": "Bearer-only client representing the protected mgmtapi. Holds no flows and obtains no tokens; it only exists to be the token audience (and, later, the token-exchange target).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "provisioner",
      "name": "swiyu-issuer provisioning client",
      "description": "Least-privilege service account the CLI uses to upsert the dev-ba tenant_id mapper via the Admin API. Granted only realm-management:manage-clients (see the service-account user below).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "provisioner-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "dev-ba",
      "name": "Development business application",
      "description": "Sample business application. Uses the client-credentials grant to call swiyu-issuer-mgmtapi on behalf of the dev tenant. The tenant_id claim is NOT here; it is added at bootstrap by the provisioner via the Admin API.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-ba-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "access.token.signed.response.alg": "EdDSA"
      },
      "defaultClientScopes": ["basic", "roles", "mgmtapi-audience"],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "principal_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "principal_type",
            "claim.value": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "swiyu-issuer-web-bff",
      "name": "swiyu-issuer web BFF (first-party)",
      "description": "Trusted first-party BFF (principal_type=first-party). Standard flow runs the user OIDC login; token exchange (RFC 8693) mints the act-as-user token whose `act` names this client and whose optional `act-as-user` scope adds `user_identity` (iss, sub).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-bff-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": ["http://localhost:4200/api/auth/callback"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "access.token.signed.response.alg": "EdDSA",
        "standard.token.exchange.enabled": "true",
        "post.logout.redirect.uris": "http://localhost:4200/login"
      },
      "defaultClientScopes": ["basic", "roles", "mgmtapi-audience"],
      "optionalClientScopes": ["act-as-user"],
      "protocolMappers": [
        {
          "name": "principal_type",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "principal_type",
            "claim.value": "first-party",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-provisioner",
      "enabled": true,
      "serviceAccountClientId": "provisioner",
      "clientRoles": {
        "realm-management": ["manage-clients"]
      }
    },
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "dev-user",
      "enabled": true,
      "emailVerified": true,
      "email": "dev-user@example.org",
      "firstName": "Dev",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "dev-user",
          "temporary": false
        }
      ]
    }
  ]
}
