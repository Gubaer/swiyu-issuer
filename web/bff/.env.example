# BFF listening port
BFF_PORT=3000

# Mgmt API base URL (trailing slash optional)
MGMTAPI_URL=http://localhost:8080

# OIDC / Keycloak — the BFF is a confidential first-party client of the realm.
# The realm is discovered from {OIDC_ISSUER_URL}/.well-known/openid-configuration
# at startup. OIDC_CLIENT_SECRET is a real secret: set it in .env (never commit).
OIDC_ISSUER_URL=http://localhost:8083/realms/swiyu-issuer
OIDC_CLIENT_ID=swiyu-issuer-web-bff
OIDC_CLIENT_SECRET=dev-bff-secret
OIDC_REDIRECT_URI=http://localhost:4200/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4200/login

# Session cookie + lifetimes. SESSION_COOKIE_SECURE must be true behind TLS.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_SECS=1800
SESSION_ABSOLUTE_TIMEOUT_SECS=36000

# Directory of built SPA assets to serve as a static fallback. Leave unset
# in dev (where `ng serve` serves the SPA and proxies `/api` here); the
# single-container image sets this to where the build is copied.
# SPA_DIR=/srv/spa
